{
  "manifest_version": 3,
  "name": "Ultraman Transkrip — Rekam Meeting",
  "version": "0.1.0",
  "description": "Rekam audio tab meeting (Meet/Zoom web) + mikrofon, kirim ke Ultraman Transkrip untuk ditranskrip.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Rekam meeting",
    "default_popup": "popup/popup.html"
  }
}
